<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Калькулятор</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="container">
        <header>
            <h1>Калькулятор</h1>
            <hr />
        </header>

        <main>
            @RenderBody()
        </main>

        <footer>
            <hr />
        </footer>
    </div>

    @RenderSection("InfoSection", required: false)
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
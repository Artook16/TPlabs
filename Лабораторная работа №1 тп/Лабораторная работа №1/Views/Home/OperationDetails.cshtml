@{
    ViewData["Title"] = "Детали операции";
}

<h2>Детали выполненной операции</h2>

@{
    string op1 = Context.Request.Query["op1"];
    string op2 = Context.Request.Query["op2"];
    string oper = Context.Request.Query["oper"];
    string res = Context.Request.Query["res"];

    if (!string.IsNullOrEmpty(op1) && !string.IsNullOrEmpty(op2) && !string.IsNullOrEmpty(oper) && !string.IsNullOrEmpty(res))
    {
        string expression = $"{op1} {oper} {op2} = {res}";

        string[] operators = { "+", "-", "*", "/" };
        string[] wordOperators = { "плюс", "минус", "умножить на", "разделить на" };

        int lastIndex = -1;
        string foundOp = "";

        for (int i = 0; i < operators.Length; i++)
        {
            int idx = expression.LastIndexOf(operators[i]);
            if (idx > lastIndex)
            {
                lastIndex = idx;
                foundOp = operators[i];
            }
        }

        if (lastIndex != -1)
        {
            int opIndex = Array.IndexOf(operators, foundOp);
            string wordOp = wordOperators[opIndex];

            string newExpression = expression.Substring(0, lastIndex) + wordOp + expression.Substring(lastIndex + foundOp.Length);

                        <p><strong>Исходная строка:</strong> @expression</p>
                        <p><strong>Обработанная строка:</strong> @newExpression</p>
        }
        else
        {
                        <p>Не удалось определить операцию.</p>
        }
    }
    else
    {
                <p>Нет данных. Сначала выполните вычисление на главной странице.</p>
    }
}


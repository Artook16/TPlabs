@model Лабораторная_работа__1.Models.CalculatorModel
@{
    ViewData["Title"] = "Калькулятор";
}

@{
    ViewData["Title"] = "Калькулятор";
}

@section InfoSection {
    <div class="info-panel">
        <h3>Информация</h3>
        @if (Model.Result.HasValue)
        {
            if (Model.Result.Value == ViewBag.ExpectedResult)
            {
                <p style="color: green;">✅ Результат совпадает с ожидаемым значением @ViewBag.ExpectedResult</p>
            }
            else
            {
                <p style="color: orange;">⚠️ Результат отличается от ожидаемого значения @ViewBag.ExpectedResult</p>
            }
        }
        else
        {
            <p>Выполните вычисление</p>
        }
    </div>
}

<h2>Калькулятор (ulong & float)</h2>

@if (ViewBag.Debug != null)
{
    <div style="background: #ffffcc; padding: 10px; margin-bottom: 20px; border: 1px solid #ffcc00;">
        <strong>🔍 Отладка:</strong><br />
        @Html.Raw(ViewBag.Debug)
    </div>
}

<form asp-controller="Home" asp-action="Index" method="post">
    @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })

    <div class="form-group">
        <label asp-for="Operand1String"></label>
        <input asp-for="Operand1String" class="textBoxStyle" />
        <span asp-validation-for="Operand1String" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Operand2String"></label>
        <input asp-for="Operand2String" class="textBoxStyle" />
        <span asp-validation-for="Operand2String" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Операция</label>
        <select name="operation" size="4" style="width:150px;">
            <option value="+">Сложение (+)</option>
            <option value="-">Вычитание (-)</option>
            <option value="*">Умножение (*)</option>
            <option value="/">Деление (/)</option>
        </select>
    </div>

    <div class="form-group">
        <label asp-for="Result"></label>
        <input asp-for="Result" class="resultBox" readonly value="@Model.Result" />
    </div>

    <div class="form-group">
        <input type="submit" name="action" value="Вычислить" class="btn btn-primary" />
        <input type="submit" name="action" value="Очистить" class="btn btn-secondary" />
    </div>
</form>

<a asp-controller="Home" asp-action="OperationDetails"
   asp-route-op1="@Model.Operand1String"
   asp-route-op2="@Model.Operand2String"
   asp-route-oper="@Model.Operation"
   asp-route-res="@Model.Result">
    Посмотреть детали операции
</a>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}